[
  {
    "name": "theme_info",
    "theme_name": "Royal Herb",
    "theme_version": "0.1.0",
    "theme_author": "Royal Herb Nic",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px recommended"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (forest green)",
        "default": "#1F3326"
      },
      {
        "type": "color",
        "id": "color_primary_contrast",
        "label": "Text on primary",
        "default": "#F4EDDF"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (antique gold)",
        "default": "#B89155"
      },
      {
        "type": "color",
        "id": "color_sage",
        "label": "Sage",
        "default": "#8A9A7B"
      },
      {
        "type": "header",
        "content": "Surfaces"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F7F2E8"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Soft surface",
        "default": "#ECE3D0"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark section background",
        "default": "#16241B"
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1B261E"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#5F6B60"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge",
        "default": "#9A4B2E"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase_eyebrow",
        "label": "Uppercase small headings",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "checkbox",
        "id": "animations",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "grain",
        "label": "Paper grain texture",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show rating (from product reviews app metafield)",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "$",
        "default": 50,
        "info": "Set to 0 to hide the progress bar. Uses the store's base currency."
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Cart drawer suggestions"
      },
      {
        "type": "text",
        "id": "free_shipping_note",
        "label": "Cart note",
        "default": "Free shipping on orders over $50"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  }
]