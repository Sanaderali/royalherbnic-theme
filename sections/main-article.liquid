<article class="section page-width page-width--narrow">
  <header class="page-header">
    <p class="muted">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page-title">{{ article.title }}</h1>
  </header>
  {%- if article.image -%}<div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw' }}</div>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="link-arrow" href="{{ blog.url }}">{{ 'blogs.back' | t }}</a></p>
</article>
{% schema %}
{ "name": "Blog post" }
{% endschema %}
