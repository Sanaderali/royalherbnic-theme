{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign featured = current_variant.featured_media | default: product.featured_media
-%}
<section class="section section--tight product-section" data-product data-section-id="{{ section.id }}">
  <div class="page-width">
    <nav class="breadcrumbs small" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      {%- if collection -%}<span>/</span><a href="{{ collection.url }}">{{ collection.title }}</a>{%- endif -%}
      <span>/</span><span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
      <div class="product__gallery" data-gallery>
        <div class="product__main-media" data-main-media data-zoom>
          {%- if featured -%}
            {{ featured | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: featured.alt | default: product.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}<span class="badge badge--sale product__sale-badge">{{ 'products.sale' | t }}</span>{%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <li>
                  <button type="button" class="product__thumb" data-thumb data-media-id="{{ media.id }}" data-src="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | escape }}" aria-label="{{ 'products.view_image' | t: index: forloop.index }}"{% if media.id == featured.id %} aria-current="true"{% endif %}>
                    {{ media | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'rating' -%}
              {%- if rating != blank -%}
                <a href="#reviews" class="product__rating" {{ block.shopify_attributes }}>
                  <span class="stars">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
                  <span class="small">{{ rating.rating | round: 1 }} · {{ 'products.reviews_count' | t: count: rating_count }}</span>
                </a>
              {%- endif -%}
            {%- when 'price' -%}
              <div class="product__price" data-price {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant %}
                <p class="small muted">{{ 'products.tax_note' | t }}</p>
              </div>
            {%- when 'subtitle' -%}
              <p class="product__subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'highlights' -%}
              <ul class="highlights" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- when 'badges' -%}
              <ul class="product-badges" {{ block.shopify_attributes }}>
                {%- assign labels = block.settings.labels | split: ',' -%}
                {%- for label in labels -%}<li>{% render 'icon', name: 'leaf' %}<span>{{ label | strip }}</span></li>{%- endfor -%}
              </ul>
            {%- when 'bundle' -%}
              {%- liquid
                assign bs = block.settings
                assign show_bundle = true
                if bs.only_tag != blank
                  assign show_bundle = false
                  if product.tags contains bs.only_tag
                    assign show_bundle = true
                  endif
                endif
              -%}
              {%- if show_bundle -%}
                <div class="bundle" data-bundle data-form-id="ProductForm-{{ section.id }}" style="--bundle-accent: {{ bs.color_accent }}; --bundle-hot: {{ bs.color_highlight }};" {{ block.shopify_attributes }}>
                  {%- if bs.heading != blank -%}<p class="bundle__heading">{{ bs.heading }}</p>{%- endif -%}
                  {%- for n in (1..3) -%}
                    {%- liquid
                      assign q_key = 'qty_' | append: n
                      assign t_key = 'title_' | append: n
                      assign l_key = 'label_' | append: n
                      assign d_key = 'discount_' | append: n
                      assign b_key = 'badge_' | append: n
                      assign qty = bs[q_key]
                      assign disc = bs[d_key]
                      if qty == 0 or bs[t_key] == blank
                        continue
                      endif
                      assign full = current_variant.price | times: qty
                      assign keep = 100 | minus: disc
                      assign pay = full | times: keep | divided_by: 100
                      assign save = full | minus: pay
                    -%}
                    <label class="bundle__tier{% if n == bs.highlight %} bundle__tier--hot{% endif %}">
                      <input type="radio" name="bundle-{{ section.id }}" value="{{ qty }}" data-bundle-qty="{{ qty }}" data-bundle-discount="{{ disc }}" {% if forloop.first %}checked{% endif %}>
                      <span class="bundle__radio"></span>
                      <span class="bundle__text">
                        <span class="bundle__title">{{ bs[t_key] }}</span>
                        <span class="bundle__label" data-bundle-label data-template="{{ bs[l_key] | escape }}">{{ bs[l_key] | replace: '[save]', save | money_without_trailing_zeros }}</span>
                      </span>
                      <span class="bundle__prices">
                        <span class="bundle__price" data-bundle-price>{{ pay | money_without_trailing_zeros }}</span>
                        {%- if disc > 0 -%}<s class="bundle__compare" data-bundle-compare>{{ full | money_without_trailing_zeros }}</s>{%- endif -%}
                      </span>
                      {%- if bs[b_key] != blank -%}<span class="bundle__badge">{{ bs[b_key] }}</span>{%- endif -%}
                    </label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, class: 'product__form', data-product-form: '', id: 'ProductForm-{{ section.id }}' -%}
                  {%- unless product.has_only_default_variant -%}
                    {%- for option in product.options_with_values -%}
                      <fieldset class="option">
                        <legend>{{ option.name }}: <span class="muted" data-option-selected>{{ option.selected_value }}</span></legend>
                        <div class="option__values">
                          {%- for value in option.values -%}
                            <label class="option__pill">
                              <input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-input>
                              <span>{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  {%- endunless -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product__buy-row">
                    <div class="qty-stepper qty-stepper--lg">
                      <button type="button" data-qty-minus aria-label="−">−</button>
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                      <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" data-qty-input>
                      <button type="button" data-qty-plus aria-label="+">+</button>
                    </div>
                    <button type="submit" class="button button--lg button--full" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                      <span data-add-label>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
                      <span class="button__sep">·</span>
                      <span data-add-price>{{ current_variant.price | money }}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}<div class="product__dynamic">{{ form | payment_button }}</div>{%- endif -%}
                  <p class="form-message" data-form-message role="status"></p>
                {%- endform -%}
                <script type="application/json" data-variants>{{ product.variants | json }}</script>
              </div>
            {%- when 'trust' -%}
              <ul class="trust" {{ block.shopify_attributes }}>
                <li>{% render 'icon', name: 'truck' %}<span>{{ block.settings.text_1 }}</span></li>
                <li>{% render 'icon', name: 'shield' %}<span>{{ block.settings.text_2 }}</span></li>
                <li>{% render 'icon', name: 'heart' %}<span>{{ block.settings.text_3 }}</span></li>
              </ul>
            {%- when 'description' -%}
              <div class="rte product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.heading }}</span>{% render 'icon', name: 'chevron' %}</summary>
                <div class="rte accordion__body">{{ block.settings.content }}{{ block.settings.page.content }}</div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="sticky-atc" data-sticky-atc hidden>
      <div class="page-width sticky-atc__inner">
        <div class="sticky-atc__product">
          {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <div>
            <p class="sticky-atc__title">{{ product.title }}</p>
            <p class="small muted" data-sticky-price>{{ current_variant.price | money }}</p>
          </div>
        </div>
        <button type="submit" form="ProductForm-{{ section.id }}" class="button" data-sticky-button {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
      </div>
    </div>
  {%- endif -%}
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "sku": {{ variant.sku | json }},
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add to cart bar on scroll", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "subtitle", "name": "Short text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "A calming blend of ancient adaptogens" }] },
    { "type": "highlights", "name": "Highlights", "settings": [{ "type": "textarea", "id": "items", "label": "One highlight per line", "default": "Supports calm and restful sleep\nWild-harvested, small-batch prepared\nNo fillers, binders or additives" }] },
    { "type": "badges", "name": "Badges", "settings": [{ "type": "text", "id": "labels", "label": "Labels (comma separated)", "default": "Vegan, Organic, Gluten free, Non-GMO" }] },
    { "type": "bundle", "name": "Bundle offer (Buy 1 / Buy 2)", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Shows package options that set the quantity. The discount shown here is for display only: create a matching automatic discount in Shopify (Discounts › Amount off products, minimum quantity) so checkout charges the same price." },
      { "type": "text", "id": "only_tag", "label": "Only show on products with this tag", "info": "e.g. bundle-offer. Leave empty to show on every product.", "default": "bundle-offer" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your package" },
      { "type": "select", "id": "highlight", "label": "Highlight option", "options": [{ "value": "1", "label": "Option 1" }, { "value": "2", "label": "Option 2" }, { "value": "3", "label": "Option 3" }], "default": "2" },
      { "type": "header", "content": "Option 1" },
      { "type": "range", "id": "qty_1", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 1 },
      { "type": "text", "id": "title_1", "label": "Title", "default": "Buy 1" },
      { "type": "text", "id": "label_1", "label": "Subtitle", "default": "Standard price" },
      { "type": "range", "id": "discount_1", "label": "Discount", "min": 0, "max": 70, "step": 1, "unit": "%", "default": 0 },
      { "type": "text", "id": "badge_1", "label": "Badge" },
      { "type": "header", "content": "Option 2" },
      { "type": "range", "id": "qty_2", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 2 },
      { "type": "text", "id": "title_2", "label": "Title", "default": "Buy 2" },
      { "type": "text", "id": "label_2", "label": "Subtitle", "info": "[save] shows the amount saved.", "default": "Save [save] + Free Delivery" },
      { "type": "range", "id": "discount_2", "label": "Discount", "min": 0, "max": 70, "step": 1, "unit": "%", "default": 10 },
      { "type": "text", "id": "badge_2", "label": "Badge", "default": "Most popular" },
      { "type": "header", "content": "Option 3" },
      { "type": "range", "id": "qty_3", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 3 },
      { "type": "text", "id": "title_3", "label": "Title", "default": "Buy 3" },
      { "type": "text", "id": "label_3", "label": "Subtitle", "default": "Save [save] + Free Delivery" },
      { "type": "range", "id": "discount_3", "label": "Discount", "min": 0, "max": 70, "step": 1, "unit": "%", "default": 15 },
      { "type": "text", "id": "badge_3", "label": "Badge", "default": "Best value" },
      { "type": "header", "content": "Colors" },
      { "type": "color", "id": "color_accent", "label": "Selected border", "default": "#1F5132" },
      { "type": "color", "id": "color_highlight", "label": "Highlighted option", "default": "#C98A2E" }
    ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }] },
    { "type": "trust", "name": "Trust icons", "limit": 1, "settings": [
      { "type": "text", "id": "text_1", "label": "Shipping", "default": "Free shipping over $50" },
      { "type": "text", "id": "text_2", "label": "Guarantee", "default": "30-day happiness guarantee" },
      { "type": "text", "id": "text_3", "label": "Quality", "default": "Lab tested for purity" }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "mortar", "label": "Mortar" }, { "value": "flask", "label": "Flask" },
        { "value": "truck", "label": "Delivery" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" }
      ], "default": "leaf" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] }
  ]
}
{% endschema %}
