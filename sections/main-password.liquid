<section class="section page-width page-width--narrow empty-state">
  <h1 class="page-title">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
    <input id="Password" type="password" name="password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password">
    <button type="submit" class="button">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password page" }
{% endschema %}
