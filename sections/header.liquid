<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" data-header>
  <div class="page-width header__inner">
    <button class="header__icon header__menu-toggle" type="button" aria-label="{{ 'general.menu' | t }}" aria-expanded="false" aria-controls="MobileNav" data-menu-toggle>
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: alt: shop.name, style: 'width:' | append: settings.logo_width | append: 'px', widths: '150, 300, 600', sizes: '300px' }}
      {%- else -%}
        <span class="header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.main_navigation' | t }}">
      <ul class="header__menu">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links != blank -%}
              <ul class="header__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon header__icon--account" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav id="MobileNav" class="mobile-nav" hidden aria-label="{{ 'general.main_navigation' | t }}">
    <ul>
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul>
              {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
