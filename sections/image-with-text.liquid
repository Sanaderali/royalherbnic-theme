<section class="section section--{{ section.settings.scheme }}">
  <div class="page-width">
    <div class="split{% if section.settings.reverse %} split--reverse{% endif %}">
      <div class="split__media reveal">
        <div class="split__main split__main--{{ section.settings.shape }}">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
          {%- else -%}
            {% render 'botanical-art', variant: 'arch' %}
          {%- endif -%}
        </div>
        {%- if section.settings.image_2 != blank -%}
          <div class="split__inset">{{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '260px' }}</div>
        {%- endif -%}
      </div>
      <div class="split__content reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- assign stats = section.blocks | where: 'type', 'stat' -%}
        {%- if stats.size > 0 -%}
          <dl class="stats">
            {%- for block in stats -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <dt class="stat__value" data-count="{{ block.settings.value }}">{{ block.settings.value }}{{ block.settings.suffix }}</dt>
                <dd class="stat__label">{{ block.settings.label }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="button button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.signature != blank -%}<p class="signature">{{ section.settings.signature }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "light", "label": "Light" }, { "value": "surface", "label": "Soft" }, { "value": "dark", "label": "Dark green" }], "default": "light" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Small overlapping image" },
    { "type": "select", "id": "shape", "label": "Image shape", "options": [{ "value": "arch", "label": "Arch" }, { "value": "rounded", "label": "Rounded" }], "default": "arch" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our roots" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the earth, with intention" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We partner with growers who share our respect for the land, harvesting each herb at the moment of peak potency, then slow-drying and blending it by hand in small batches.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "signature", "label": "Signature line", "default": "The Royal Herb family" }
  ],
  "blocks": [{ "type": "stat", "name": "Statistic", "settings": [
    { "type": "text", "id": "value", "label": "Number", "default": "100" },
    { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
    { "type": "text", "id": "label", "label": "Label", "default": "Natural ingredients" }
  ] }],
  "max_blocks": 3,
  "presets": [{ "name": "Image with text", "blocks": [
    { "type": "stat", "settings": { "value": "100", "suffix": "%", "label": "Natural ingredients" } },
    { "type": "stat", "settings": { "value": "10", "suffix": "k+", "label": "Happy customers" } },
    { "type": "stat", "settings": { "value": "30", "suffix": "+", "label": "Botanicals" } }
  ] }]
}
{% endschema %}
