{%- paginate collection.products by section.settings.per_page -%}
<section class="collection-hero{% if collection.image and section.settings.show_image %} collection-hero--image{% endif %}">
  {%- if collection.image and section.settings.show_image -%}
    <div class="collection-hero__bg">{{ collection.image | image_url: width: 2000 | image_tag: widths: '800, 1400, 2000', sizes: '100vw', loading: 'eager' }}</div>
  {%- endif -%}
  <div class="page-width collection-hero__inner">
    <nav class="breadcrumbs small" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span>{{ collection.title }}</span></nav>
    <h1 class="page-title display">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte collection-hero__desc">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>

<section class="section section--tight">
  <div class="page-width">
    {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
    <form class="collection-form" method="get" data-filter-form>
      <div class="toolbar">
        <button type="button" class="toolbar__filter-btn" data-open-filters>{% render 'icon', name: 'filter' %} {{ 'collections.filter' | t }}</button>
        <p class="toolbar__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        <div class="toolbar__sort">
          <label for="SortBy" class="small muted">{{ 'collections.sort_by' | t }}</label>
          <select id="SortBy" name="sort_by" data-auto-submit>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      {%- liquid
        assign active_count = 0
        for filter in collection.filters
          assign active_count = active_count | plus: filter.active_values.size
        endfor
      -%}
      {%- if active_count > 0 -%}
        <div class="chips">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="chip" href="{{ value.url_to_remove }}">{{ value.label }} {% render 'icon', name: 'close' %}</a>
            {%- endfor -%}
          {%- endfor -%}
          <a class="link-muted small" href="{{ collection.url }}?sort_by={{ current_sort }}">{{ 'collections.clear' | t }}</a>
        </div>
      {%- endif -%}

      <div class="collection-layout{% if collection.filters.size > 0 %} has-filters{% endif %}">
        {%- if collection.filters.size > 0 -%}
          <aside class="filters" data-filters>
            <div class="filters__head">
              <p class="drawer__title">{{ 'collections.filter' | t }}</p>
              <button type="button" class="header__icon" aria-label="{{ 'general.close' | t }}" data-close-filters>{% render 'icon', name: 'close' %}</button>
            </div>
            {%- for filter in collection.filters -%}
              <details class="filters__group" open>
                <summary>{{ filter.label }}{% render 'icon', name: 'chevron' %}</summary>
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul>
                      {%- for value in filter.values -%}
                        <li>
                          <label class="checkbox">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} data-auto-submit>
                            <span class="checkbox__box"></span>
                            <span>{{ value.label }}</span>
                            <span class="muted small">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    <div class="filters__price">
                      <input type="number" name="{{ filter.min_value.param_name }}" placeholder="{{ 0 | money_without_currency }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency }}{% endif %}" aria-label="Min">
                      <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency }}{% endif %}" aria-label="Max">
                      <button class="button button--small button--full" type="submit">{{ 'collections.apply' | t }}</button>
                    </div>
                {%- endcase -%}
              </details>
            {%- endfor -%}
          </aside>
        {%- endif -%}

        <div class="grid grid--{{ section.settings.columns }}">
          {%- for product in collection.products -%}
            <div class="reveal" style="--delay: {{ forloop.index0 | modulo: 4 | times: 60 }}ms">{% render 'product-card', product: product %}</div>
          {%- else -%}
            {% render 'product-card-placeholder', count: 8 %}
          {%- endfor -%}
        </div>
      </div>
    </form>

    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show collection image as banner", "default": true },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" }
  ]
}
{% endschema %}
