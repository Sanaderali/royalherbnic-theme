{%- paginate collection.products by section.settings.per_page -%}
<section class="section page-width">
  <header class="page-header">
    <h1 class="page-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte page-header__desc">{{ collection.description }}</div>{%- endif -%}
  </header>

  <div class="toolbar">
    <p class="toolbar__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
    <form class="toolbar__sort" method="get">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">{%- endfor -%}
      {%- endfor -%}
      <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
      {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <div class="collection-layout">
    {%- if collection.filters.size > 0 -%}
      <aside class="filters">
        <form method="get">
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- for filter in collection.filters -%}
            <details class="filters__group" open>
              <summary>{{ filter.label }}</summary>
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul>
                    {%- for value in filter.values -%}
                      <li><label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} onchange="this.form.submit()"> {{ value.label }} <span class="muted">({{ value.count }})</span></label></li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filters__price">
                    <input type="number" name="{{ filter.min_value.param_name }}" placeholder="{{ 0 | money_without_currency }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency }}{% endif %}" aria-label="Min">
                    <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency }}{% endif %}" aria-label="Max">
                    <button class="button button--small" type="submit">{{ 'collections.apply' | t }}</button>
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
          <a class="link-arrow" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear' | t }}</a>
        </form>
      </aside>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>{{ 'collections.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" }
  ]
}
{% endschema %}
