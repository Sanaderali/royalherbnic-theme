<section class="section testimonials-section section--{{ section.settings.scheme }}" data-carousel>
  <div class="page-width">
    <div class="section__header reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.summary != blank -%}
          <p class="testimonials__summary"><span class="stars">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span> {{ section.settings.summary }}</p>
        {%- endif -%}
      </div>
      <div class="carousel__nav">
        <button type="button" class="carousel__btn" aria-label="{{ 'general.previous' | t }}" data-carousel-prev>{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="carousel__btn" aria-label="{{ 'general.next' | t }}" data-carousel-next>{% render 'icon', name: 'arrow' %}</button>
      </div>
    </div>
    <div class="carousel" data-carousel-track>
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="stars" aria-label="{{ block.settings.rating }} / 5">
            {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}<p class="testimonial__title">{{ block.settings.title }}</p>{%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            {%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', class: 'testimonial__avatar', alt: block.settings.author }}{%- else -%}<span class="testimonial__avatar testimonial__avatar--initial">{{ block.settings.author | slice: 0 }}</span>{%- endif -%}
            <span>
              <strong>{{ block.settings.author }}</strong>
              <span class="testimonial__verified">{% render 'icon', name: 'check' %} {{ 'general.verified_buyer' | t }}</span>
            </span>
            {%- if block.settings.product != blank -%}
              <a class="testimonial__product" href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "light", "label": "Light" }, { "value": "surface", "label": "Soft" }, { "value": "dark", "label": "Dark green" }], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our community" },
    { "type": "text", "id": "summary", "label": "Rating summary", "default": "4.9 average from 2,000+ reviews" }
  ],
  "blocks": [{ "type": "testimonial", "name": "Testimonial", "settings": [
    { "type": "text", "id": "title", "label": "Headline", "default": "Truly the best quality" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I've tried many herbal brands and nothing compares. You can see and smell the freshness." },
    { "type": "text", "id": "author", "label": "Author", "default": "Amina R." },
    { "type": "image_picker", "id": "avatar", "label": "Photo" },
    { "type": "product", "id": "product", "label": "Product reviewed" },
    { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
  ] }],
  "max_blocks": 12,
  "presets": [{ "name": "Testimonials", "blocks": [
    { "type": "testimonial", "settings": { "title": "Truly the best quality", "author": "Amina R." } },
    { "type": "testimonial", "settings": { "title": "Part of my daily ritual", "quote": "The calming blend has become my evening ritual. Beautiful packaging and fast delivery too.", "author": "Daniel K." } },
    { "type": "testimonial", "settings": { "title": "I noticed the difference", "quote": "Within a few weeks I felt more balanced. I love knowing exactly what's inside.", "author": "Sara M." } },
    { "type": "testimonial", "settings": { "title": "Gift-worthy", "quote": "Bought it as a gift and ended up ordering for myself. Exceptional.", "author": "Yusuf A." } }
  ] }]
}
{% endschema %}
