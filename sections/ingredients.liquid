<section class="section ingredients section--{{ section.settings.scheme }}">
  <div class="page-width">
    <div class="section__header section__header--center reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="section__sub rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
    <div class="ingredients__grid">
      {%- for block in section.blocks -%}
        <article class="ingredient reveal" style="--delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <div class="ingredient__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 22vw, 45vw' }}
            {%- else -%}
              {%- assign demo = 'ashwagandha,turmeric,moringa,blackseed' | split: ',' -%}
              {%- assign d = forloop.index0 | modulo: 4 -%}
              {%- assign demo_file = 'rh-ingredient-' | append: demo[d] | append: '.svg' -%}
              {% render 'demo-image', file: demo_file, width: 600, height: 600 %}
            {%- endif -%}
          </div>
          <p class="ingredient__latin">{{ block.settings.latin }}</p>
          <h3 class="ingredient__name">{{ block.settings.name }}</h3>
          <p class="ingredient__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark green" }, { "value": "surface", "label": "Soft" }, { "value": "light", "label": "Light" }], "default": "dark" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Inside every jar" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients you can pronounce" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every herb is traced to its origin, tested for purity and chosen at peak potency.</p>" }
  ],
  "blocks": [{ "type": "ingredient", "name": "Ingredient", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "name", "label": "Name", "default": "Ashwagandha" },
    { "type": "text", "id": "latin", "label": "Botanical name", "default": "Withania somnifera" },
    { "type": "textarea", "id": "text", "label": "Benefit", "default": "An adaptogen revered for calm and resilience." }
  ] }],
  "max_blocks": 8,
  "presets": [{ "name": "Ingredients", "blocks": [
    { "type": "ingredient", "settings": { "name": "Ashwagandha", "latin": "Withania somnifera", "text": "An adaptogen revered for calm and resilience." } },
    { "type": "ingredient", "settings": { "name": "Turmeric", "latin": "Curcuma longa", "text": "Golden root for joint comfort and vitality." } },
    { "type": "ingredient", "settings": { "name": "Moringa", "latin": "Moringa oleifera", "text": "Nutrient-dense leaf for daily energy." } },
    { "type": "ingredient", "settings": { "name": "Black seed", "latin": "Nigella sativa", "text": "A time-honoured seed for immune support." } }
  ] }]
}
{% endschema %}
