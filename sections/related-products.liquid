<section class="section{% if section.settings.surface %} section--surface{% endif %}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section__header"><div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div></div>
      <div class="grid grid--4 grid--slider">
        {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-width">
      <div class="section__header"><div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div></div>
      <div class="grid grid--4 grid--slider">{% render 'product-card-placeholder', count: section.settings.limit, offset: 4 %}</div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Complete the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also love" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "surface", "label": "Soft background", "default": true }
  ]
}
{% endschema %}
