<section class="press">
  <div class="page-width press__inner">
    {%- if section.settings.heading != blank -%}<p class="eyebrow press__heading">{{ section.settings.heading }}</p>{%- endif -%}
    <ul class="press__list">
      {%- for block in section.blocks -%}
        <li class="press__item" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'press__logo' }}
          {%- else -%}
            <span class="press__name">{{ block.settings.name }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logos / As seen in",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" }],
  "blocks": [{ "type": "logo", "name": "Logo", "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "name", "label": "Name (shown if no image)", "default": "Wellness Weekly" }
  ] }],
  "max_blocks": 8,
  "presets": [{ "name": "Logos / As seen in", "blocks": [
    { "type": "logo", "settings": { "name": "Wellness Weekly" } },
    { "type": "logo", "settings": { "name": "The Herbalist" } },
    { "type": "logo", "settings": { "name": "Natural Living" } },
    { "type": "logo", "settings": { "name": "Botanica" } },
    { "type": "logo", "settings": { "name": "Pure Journal" } }
  ] }]
}
{% endschema %}
