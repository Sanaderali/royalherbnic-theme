<section class="section process section--{{ section.settings.scheme }}">
  <div class="page-width">
    <div class="section__header section__header--center reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ol class="process__list">
      {%- for block in section.blocks -%}
        <li class="process__step reveal" style="--delay: {{ forloop.index0 | times: 100 }}ms" {{ block.shopify_attributes }}>
          <span class="process__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="process__title">{{ block.settings.title }}</h3>
          <p class="process__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Process steps",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "light", "label": "Light" }, { "value": "surface", "label": "Soft" }, { "value": "dark", "label": "Dark green" }], "default": "surface" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Seed to shelf" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted with intention, every step" }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Sourced" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Harvested from trusted growers at peak potency." }
  ] }],
  "max_blocks": 6,
  "presets": [{ "name": "Process steps", "blocks": [
    { "type": "step", "settings": { "title": "Ethically sourced", "text": "Harvested from trusted growers at peak potency." } },
    { "type": "step", "settings": { "title": "Gently prepared", "text": "Slow dried and ground to protect natural compounds." } },
    { "type": "step", "settings": { "title": "Lab tested", "text": "Every batch is checked for purity and quality." } },
    { "type": "step", "settings": { "title": "Packed fresh", "text": "Sealed in small batches and shipped to your door." } }
  ] }]
}
{% endschema %}
