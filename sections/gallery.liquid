<section class="section">
  <div class="page-width">
    <div class="section__header section__header--center reveal"><div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div></div>
    <div class="gallery">
      {%- for block in section.blocks -%}
        <a class="gallery__item reveal" style="--delay: {{ forloop.index0 | times: 60 }}ms" href="{{ block.settings.link | default: section.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 990px) 20vw, 50vw' }}
          {%- else -%}
            {%- assign demo = 'turmeric,calm,rosehip,moringa,blackseed,neem,ashwagandha,immunity' | split: ',' -%}
            {%- assign d = forloop.index0 | modulo: 8 -%}
            {%- assign demo_file = 'rh-product-' | append: demo[d] | append: '-2.svg' -%}
            {% render 'demo-image', file: demo_file %}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.link != blank -%}<p class="center"><a class="button button--outline" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "@royalherbnic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals from our community" },
    { "type": "url", "id": "link", "label": "Link (e.g. Instagram)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow along" }
  ],
  "blocks": [{ "type": "image", "name": "Image", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Link" }
  ] }],
  "max_blocks": 10,
  "presets": [{ "name": "Photo gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
