<section class="section benefits benefits--{{ section.settings.style }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="section__header section__header--center reveal"><h2 class="section__title">{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <div class="benefit reveal" style="--delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <h3 class="benefit__title">{{ block.settings.title }}</h3>
            <p class="benefit__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icons with text",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "bar", "label": "Compact trust bar" }, { "value": "cards", "label": "Large cards" }], "default": "bar" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [{ "type": "benefit", "name": "Item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [
      { "value": "leaf", "label": "Leaf" }, { "value": "mortar", "label": "Mortar and pestle" },
      { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Delivery" },
      { "value": "heart", "label": "Heart" }, { "value": "drop", "label": "Drop" },
      { "value": "flask", "label": "Lab flask" }, { "value": "recycle", "label": "Eco" }
    ], "default": "leaf" },
    { "type": "text", "id": "title", "label": "Title", "default": "100% natural" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "No fillers, no artificial additives." }
  ] }],
  "max_blocks": 6,
  "presets": [{ "name": "Icons with text", "blocks": [
    { "type": "benefit", "settings": { "icon": "leaf", "title": "100% natural", "text": "No fillers or additives" } },
    { "type": "benefit", "settings": { "icon": "flask", "title": "Lab tested", "text": "Purity in every batch" } },
    { "type": "benefit", "settings": { "icon": "recycle", "title": "Eco packaging", "text": "Recyclable and plastic-light" } },
    { "type": "benefit", "settings": { "icon": "truck", "title": "Fast delivery", "text": "Shipped within 24 hours" } }
  ] }]
}
{% endschema %}
