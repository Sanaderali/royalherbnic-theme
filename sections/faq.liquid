<section class="section page-width faq">
  {%- if section.settings.heading != blank -%}<div class="section__header section__header--center"><h2 class="section__title">{{ section.settings.heading }}</h2></div>{%- endif -%}
  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="faq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }],
  "blocks": [{
    "type": "question", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How should I store my herbs?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Keep them in a cool, dry place away from direct sunlight.</p>" }
    ]
  }],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
