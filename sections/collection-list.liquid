<section class="section page-width">
  {%- if section.settings.heading != blank -%}<div class="section__header"><h2 class="section__title">{{ section.settings.heading }}</h2></div>{%- endif -%}
  <div class="grid grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <a class="tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="tile__media">
          {%- if c.featured_image -%}
            {{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <span class="tile__label">{{ c.title | default: 'Collection' }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by need" }],
  "blocks": [{ "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }] }],
  "max_blocks": 8,
  "presets": [{ "name": "Collection list", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
