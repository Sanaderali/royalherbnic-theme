{%- if section.blocks.size > 0 -%}
<div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }};" data-announcement>
  <div class="page-width announcement__inner">
    <div class="announcement__track">
      {%- for block in section.blocks -%}
        <div class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#16241B" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#E9D8B4" },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping on orders over $50" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
