<section class="section page-width cart">
  <header class="page-header"><h1 class="page-title">{{ 'cart.title' | t }}</h1></header>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart__form">
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a href="{{ item.url }}" class="cart-item__media">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
            </a>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
              {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<p class="muted">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}{%- endfor -%}
              <p>{{ item.final_price | money }}</p>
            </div>
            <div class="cart-item__qty">
              <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'products.quantity' | t }}</label>
              <input class="qty" id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              <a class="muted" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <p class="cart-item__total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart__footer">
        <div class="cart__note">
          <label for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
        </div>
        <div class="cart__summary">
          {%- if settings.free_shipping_note != blank -%}<p class="cart__ship-note">{{ settings.free_shipping_note }}</p>{%- endif -%}
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="muted">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="update" class="button button--outline">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}<div class="cart__dynamic">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}
