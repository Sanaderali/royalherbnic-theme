<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header section__header--center reveal"><div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div></div>
    {%- endif -%}
    <div class="video reveal" data-video>
      <div class="video__poster">
        {%- if section.settings.cover != blank -%}
          {{ section.settings.cover | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw' }}
        {%- else -%}
          {% render 'demo-image', file: 'rh-wide-leaves.svg', width: 1600, height: 900 %}
        {%- endif -%}
        {%- if section.settings.video != blank -%}
          <button type="button" class="video__play" aria-label="{{ 'general.play_video' | t }}" data-video-play>{% render 'icon', name: 'play' %}</button>
        {%- endif -%}
      </div>
      {%- if section.settings.video != blank -%}
        <template data-video-template>
          {%- if section.settings.video.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video.id }}?autoplay=1&rel=0" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video.id }}?autoplay=1" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch how it's made" },
    { "type": "video_url", "id": "video", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover", "label": "Cover image" }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
