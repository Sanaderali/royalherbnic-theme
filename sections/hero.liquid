<section class="hero hero--{{ section.settings.height }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', fetchpriority: 'high', loading: 'eager', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="page-width hero__content hero__content--{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a class="button button--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "select", "id": "height", "label": "Height", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "align", "label": "Content alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Pure · Natural · Time-honoured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness, the way nature intended" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtfully sourced herbs and botanical blends for everyday balance.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Our story" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
