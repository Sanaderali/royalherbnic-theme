<section class="newsletter{% if section.settings.image != blank %} newsletter--image{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="newsletter__bg">{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1400, 2000', sizes: '100vw' }}</div>
  {%- endif -%}
  <div class="page-width newsletter__inner reveal">
    {% render 'icon', name: 'leaf' %}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {%- form 'customer', id: 'NewsletterSection', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" autocomplete="email">
        <button type="submit" class="button button--accent">{{ 'newsletter.subscribe' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <p class="small newsletter__fine">{{ 'newsletter.fine_print' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Join the herbal circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Seasonal rituals, herbal wisdom and members-only offers, delivered gently to your inbox.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
