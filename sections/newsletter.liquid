<section class="section newsletter">
  <div class="page-width newsletter__inner">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {%- form 'customer', id: 'NewsletterSection', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" autocomplete="email">
        <button type="submit" class="button button--accent">{{ 'newsletter.subscribe' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our herbal circle" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wellness tips, new arrivals and members-only offers.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
