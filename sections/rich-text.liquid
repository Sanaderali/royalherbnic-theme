<section class="section page-width rich-text rich-text--{{ section.settings.align }}">
  {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="rte">{{ section.settings.text }}</div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in tradition" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share your brand's story here.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
