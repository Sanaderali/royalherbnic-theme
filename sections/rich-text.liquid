{%- liquid
  assign heading = section.settings.heading
  if section.settings.heading_italic != blank
    assign italic = '<em>' | append: section.settings.heading_italic | append: '</em>'
    assign heading = heading | replace: section.settings.heading_italic, italic
  endif
-%}
<section class="section rich-text rich-text--{{ section.settings.align }} section--{{ section.settings.scheme }}">
  <div class="page-width page-width--medium reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if heading != blank -%}<h2 class="statement">{{ heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="link-arrow" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Statement text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "light", "label": "Light" }, { "value": "surface", "label": "Soft" }, { "value": "dark", "label": "Dark green" }], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our philosophy" },
    { "type": "textarea", "id": "heading", "label": "Statement", "default": "We believe true wellness grows slowly, rooted in nature and nurtured by tradition." },
    { "type": "text", "id": "heading_italic", "label": "Words to show in italic", "default": "rooted in nature" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Link label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" }
  ],
  "presets": [{ "name": "Statement text" }]
}
{% endschema %}
