{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  endif
-%}
<aside class="drawer drawer--right" id="CartDrawer" data-cart-drawer aria-label="{{ 'cart.title' | t }}" hidden>
  <div class="drawer__head">
    <h2 class="drawer__title">{{ 'cart.title' | t }} <span class="muted">({{ cart.item_count }})</span></h2>
    <button type="button" class="header__icon" aria-label="{{ 'general.close' | t }}" data-close-drawer>{% render 'icon', name: 'close' %}</button>
  </div>

  {%- if threshold > 0 -%}
    <div class="ship-progress">
      <p>
        {%- if remaining > 0 -%}
          {{ 'cart.shipping_remaining_html' | t: amount: remaining | money }}
        {%- else -%}
          {{ 'cart.shipping_unlocked' | t }}
        {%- endif -%}
      </p>
      <div class="ship-progress__bar"><span style="width: {{ progress }}%"></span></div>
    </div>
  {%- endif -%}

  <div class="drawer__body">
    {%- if cart.item_count > 0 -%}
      <ul class="drawer-items">
        {%- for item in cart.items -%}
          <li class="drawer-item">
            <a href="{{ item.url }}" class="drawer-item__media">
              {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
            </a>
            <div class="drawer-item__info">
              <a href="{{ item.url }}" class="drawer-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted small">{{ item.variant.title }}</p>{%- endunless -%}
              <div class="drawer-item__row">
                <div class="qty-stepper">
                  <button type="button" data-cart-change="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="−">−</button>
                  <span>{{ item.quantity }}</span>
                  <button type="button" data-cart-change="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="+">+</button>
                </div>
                <span class="drawer-item__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="link-muted small" data-cart-change="{{ item.key }}" data-qty="0">{{ 'cart.remove' | t }}</button>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if settings.cart_upsell_collection != blank -%}
        <div class="drawer-upsell">
          <p class="eyebrow">{{ 'cart.pairs_well' | t }}</p>
          <div class="drawer-upsell__list">
            {%- assign shown = 0 -%}
            {%- for product in settings.cart_upsell_collection.products -%}
              {%- assign in_cart = false -%}
              {%- for item in cart.items -%}{%- if item.product_id == product.id -%}{%- assign in_cart = true -%}{%- endif -%}{%- endfor -%}
              {%- if in_cart or product.available == false or shown >= 3 -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <div class="drawer-upsell__item">
                <a href="{{ product.url }}" class="drawer-item__media">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}</a>
                <div>
                  <a href="{{ product.url }}" class="small">{{ product.title }}</a>
                  <p class="small muted">{{ product.price | money }}</p>
                </div>
                {%- form 'product', product, data-ajax-cart: '' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="button button--small button--outline">+</button>
                {%- endform -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="drawer__empty">
        {% render 'icon', name: 'leaf' %}
        <p>{{ 'cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="drawer__foot">
      <p class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
      <p class="muted small">{{ 'cart.taxes_note' | t }}</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
      </form>
      <a class="link-arrow small" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
    </div>
  {%- endif -%}
</aside>
