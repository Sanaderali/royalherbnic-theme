<section class="section">
  <div class="page-width page-width--medium">
    <div class="section__header section__header--center reveal"><div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div></div>
    <div class="compare reveal">
      <div class="compare__row compare__row--head">
        <span></span>
        <span class="compare__us">{{ section.settings.us_label | default: shop.name }}</span>
        <span>{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="compare__row" {{ block.shopify_attributes }}>
          <span>{{ block.settings.feature }}</span>
          <span class="compare__us">{%- if block.settings.us -%}{% render 'icon', name: 'check' %}{%- else -%}{% render 'icon', name: 'close' %}{%- endif -%}</span>
          <span class="compare__them">{%- if block.settings.them -%}{% render 'icon', name: 'check' %}{%- else -%}{% render 'icon', name: 'close' %}{%- endif -%}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not all herbs are created equal" },
    { "type": "text", "id": "us_label", "label": "Your column label" },
    { "type": "text", "id": "them_label", "label": "Other column label", "default": "Others" }
  ],
  "blocks": [{ "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "feature", "label": "Feature", "default": "100% pure herbs" },
    { "type": "checkbox", "id": "us", "label": "You have it", "default": true },
    { "type": "checkbox", "id": "them", "label": "Others have it", "default": false }
  ] }],
  "max_blocks": 10,
  "presets": [{ "name": "Comparison table", "blocks": [
    { "type": "row", "settings": { "feature": "100% pure herbs, no fillers", "us": true, "them": false } },
    { "type": "row", "settings": { "feature": "Small-batch prepared", "us": true, "them": false } },
    { "type": "row", "settings": { "feature": "Third-party lab tested", "us": true, "them": false } },
    { "type": "row", "settings": { "feature": "Traceable sourcing", "us": true, "them": false } },
    { "type": "row", "settings": { "feature": "Artificial colours or flavours", "us": false, "them": true } }
  ] }]
}
{% endschema %}
