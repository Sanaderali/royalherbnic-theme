{%- paginate blog.articles by 9 -%}
<section class="section page-width">
  <header class="page-header"><h1 class="page-title">{{ blog.title }}</h1></header>
  <div class="grid grid--3">
    {%- for article in blog.articles -%}
      <a class="article-card" href="{{ article.url }}">
        <div class="tile__media">
          {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '33vw' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        </div>
        <p class="muted">{{ article.published_at | time_tag: format: 'date' }}</p>
        <h2 class="card__title">{{ article.title }}</h2>
        <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog posts" }
{% endschema %}
